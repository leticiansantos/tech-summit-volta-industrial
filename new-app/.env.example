# Local development environment.
# Copy to `.env` and adjust. In Databricks Apps these are injected automatically.

# Workspace host (no trailing slash)
DATABRICKS_HOST=https://fe-sandbox-serverless-sandbox-admin.cloud.databricks.com

# Local auth: name of the Databricks CLI profile to pull tokens from.
# (Run `databricks auth login --host <host> --profile sandbox-admin` first.)
DATABRICKS_PROFILE=sandbox-admin

# Data + AI resources (all in the fe-sandbox workspace)
DATABRICKS_CATALOG=serverless_sandbox_admin_catalog
DATABRICKS_SCHEMA=default
DATABRICKS_WAREHOUSE_ID=0b14e41d73a2ccf0
GENIE_SPACE_ID=01f1a24279411b67a8b2f4bfbde46a4f

# Foundation Model used for maintenance-plan drafting / explainability
SERVING_ENDPOINT=databricks-claude-sonnet-4-5

# Custom maintenance-risk model serving endpoint (XGBoost failure_recommender).
# When set, server/lib/model.js scores candidate actions live against this endpoint.
MAINTENANCE_MODEL_ENDPOINT=volta-prediction-model

PORT=8000
