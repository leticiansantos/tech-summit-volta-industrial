{
  "name": "volta-industrial-app",
  "version": "1.0.0",
  "description": "Volta Industrial — Downtime & Maintenance Rescue (Databricks App)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "build:server": "esbuild server/index.js --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --banner:js=\"import{createRequire as _cr}from'module';const require=_cr(import.meta.url);\"",
    "install:all": "npm install && cd client && npm install",
    "client:dev": "cd client && npm run dev"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
